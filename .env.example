# Copy this file to `.env` and fill in the values: cp .env.example .env

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wondermaid"

# Upstash Redis (REST) for caching Enka.Network responses for 5 minutes.
# Optional in development: without it every UID lookup goes straight to Enka.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Copy this file to `.env` and fill in the values: cp .env.example .env

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wondermaid"

# Upstash Redis (REST) for caching Enka.Network responses for 5 minutes.
# Optional in development: without it every UID lookup goes straight to Enka.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set at build time by CI (see README "Deploying"): shown in the version badge in the corner of the site
# NEXT_PUBLIC_APP_VERSION=""
# NEXT_PUBLIC_GIT_SHA=""
# NEXT_PUBLIC_APP_ENV="production"   # or "staging"
# Base URL for social preview images (defaults to https://wondermaid.app)
# NEXT_PUBLIC_SITE_URL=""

# Point Enka requests at another server, e.g. a mock showcase on PRE (defaults to https://enka.network/api/uid)
# ENKA_API_URL=""

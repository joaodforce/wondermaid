{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@genshin-optimizer/pando/engine": ["./vendor/genshin-optimizer/libs/pando/engine/src/index.ts"],
      "@genshin-optimizer/game-opt/engine": ["./vendor/genshin-optimizer/libs/game-opt/engine/src/index.ts"],
      "@genshin-optimizer/game-opt/formula": ["./vendor/genshin-optimizer/libs/game-opt/formula/src/index.ts"],
      "@genshin-optimizer/common/util": ["./vendor/genshin-optimizer/libs/common/util/src/index.ts"],
      "@genshin-optimizer/gi/consts": ["./vendor/genshin-optimizer/libs/gi/consts/src/index.ts"],
      "@genshin-optimizer/gi/stats": ["./vendor/genshin-optimizer/libs/gi/stats/src/index.ts"],
      "@genshin-optimizer/gi/formula": ["./vendor/genshin-optimizer/libs/gi/formula/src/index.ts"],
      "@genshin-optimizer/gi/dm": ["./vendor/genshin-optimizer/libs/gi/dm/src/index.ts"],
      "@genshin-optimizer/gi/good": ["./vendor/genshin-optimizer/libs/gi/good/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}

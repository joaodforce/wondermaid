{
  "name": "noelle-leaderboard",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:bundle": "esbuild src/db/migrate.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/migrate.cjs",
    "leaderboard:recalculate": "tsx scripts/recalculate-ranks.ts",
    "leaderboard:recalculate:bundle": "esbuild scripts/recalculate-ranks.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/recalculate.cjs",
    "leaderboard:backfill": "tsx scripts/backfill-players.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
